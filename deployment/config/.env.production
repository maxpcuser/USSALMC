
# Environment-specific configuration for USSA Lore Master Knowledge Core

# Main Environment Configuration
ENV=production
NODE_ENV=production

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledge_core_db
DB_USER=knowledge_core_user  
DB_PASSWORD=secure_password_here

# Service Ports
API_PORT=3000
WEB_PORT=4200
WORKER_PORT=3001
SCRAPER_PORT=3002

# Redis Settings  
REDIS_HOST=localhost
REDIS_PORT=6379

# Search Configuration
SEARCH_ENGINE=elasticsearch
SEARCH_HOST=localhost
SEARCH_PORT=9200

# Cache Settings
CACHE_TTL_SECONDS=3600

# Logging Configuration 
LOG_LEVEL=info
LOG_PATH=/var/log/knowledge-core/
